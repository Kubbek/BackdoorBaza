VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-anon-key

# Tylko dla backendu (api/*.js) — NIGDY nie dodawaj prefiksu VITE_ do tych
# dwóch, inaczej trafią do kodu w przeglądarce. service_role key znajdziesz
# w Supabase: Project Settings → API → service_role (sekret, nie commituj).
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=twoj-service-role-key

# Sekret zabezpieczający codzienny backup (api/backup-cron.js) — dowolny
# losowy ciąg znaków, ustaw tylko na Vercelu (nie trzeba lokalnie). Bez
# niego endpoint backupu byłby publicznie wywoływalny przez każdego.
CRON_SECRET=wymysl-dlugi-losowy-ciag-znakow
